# Latest change: Wed Nov 30 00:12:45 CET 2005 [mika]
################################################################################

# source generic screenrc
  source /etc/grml/screenrc

# set status lines
  caption always "%{b4;0}$USER@%{b7;0}%H | %{b3;0}(load: %1` |%{b1;0} cpu: %2` | %{b2;0}net: %3`) %=%{b7;0}%D %Y-%m-%d %0c "
# caption always "%{b4;0}$USER@%{b7;0}%H%{2;0} | %c %{b3;0}%D %d.%m.%Y | %{b1;0}(load: %1` | cpu: %2`) %=%{b7;0}%D %Y-%m-%d %0c "
# caption always "%{b4;0}$USER@%{b7;0}%H%{2;0} | %c %{b3;0}%D %d.%m.%Y | %{b1;0}(load: %1` | cpu: %2` | acpi: %2`)"
# caption always "%{b4;0}$USER%{b7;0}%H: screen%{2;0} |%c %{b3;0}%d.%m.%Y | %{b1;0}(system load: %1`) %=%{b7;0}%D %Y-%m-%d %0c "
  hardstatus alwayslastline "%{1;7}%n%f %t %{7;0} | %-Lw%{4;7}%n%f %t%?(%u)%?%{7;0}%+Lw%="

## END OF FILE #################################################################
