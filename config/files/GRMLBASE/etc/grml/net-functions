# shellcheck shell=bash

getWlanDevices() {
  awk 'FS=":" {gsub(" ", ""); if(NR>2 ) print $1 | "sort" } ' /proc/net/wireless
}

# getLanDriver deviceName
getLanDriver() {
    if [ -e "/sys/class/net/$1/device/driver" ] ; then
        basename "$(readlink "/sys/class/net/$1/device/driver")"
    fi
}

