_grmllive_flavours() { #{{{
  local expl
  local -a flavours

  flavours=(
    grml
    grml-full
    grml-small
  )
  _wanted list expl 'grml flavour(s)' compadd ${expl} -- ${flavours}
}
#}}}
_grmllive_classes() { #{{{
    local expl
    local -a already static_classes

    static_classes=(
        DEBORPHAN FRESHCLAM
        GRML_FULL GRML_SMALL
        LATEX LOCALES NO_ONLINE REMOVE_DOCS SOURCES TOR XORG ZFS
    )
    compset -P '*,'
    already=(${(s<,>)IPREFIX})
    _wanted list expl 'classe(s)' compadd -S, -F already -q ${expl} -- \
        /usr/share/grml-live/config/env/*(.N:t:r) ${static_classes}
}
#}}}
_grmllive_suites() { #{{{
  local expl
  local -a suites

  suites=(
    stable testing unstable bookworm sid trixie forky
  )
  _wanted list expl 'Debian suite' compadd ${expl} -- ${suites}
}
#}}}
_grmllive_apt_snapshot_dates() { #{{{
  local -a expl dates
  # Get last 6 months of dates
  zmodload -i zsh/datetime && {
    local i date last=$EPOCHSECONDS
    for (( i = 0; i < 180; i++ )); do
      strftime -s date %Y%m%d $last
      dates+=( $date )
      last=$(( last - (24 * 60 * 60) ))
    done
  }
  _wanted list expl 'wayback date (yyyymmdd[ThhmmssZ])' compadd -- $dates
}
#}}}

arguments=( #{{{
  '(-w)--bootstrap-mirror-url[Debian mirror URL for creating chroot]:mirror URL:_urls'
  '--boot-options[add these boot options to the defaults]:boot options:'
  '--distri-info[set DISTRI_INFO, a one-line description of the built system]:distribution info:'
  '--distri-name[set DISTRI_NAME]:distribution name:'
  '--hostname[set the hostname of the booted live system]:hostname:'
  '--secure-boot[enable Secure Boot using the Debian method]'
  '--username[set the name of the created non-root user]:username:'
  '(-b -B -u -q)-B[build the ISO without touching the chroot (skips cleanup)]'
  '(-b -B -u -q)-b[build the ISO without updating the chroot via FAI]'
  '-c[available grml-live classes]:classe(s):_grmllive_classes'
  '-D[use specified configuration directory instead of automatically chosen default]:directory:_path_files -/'
  '-d[use specified date instead of build time as date of release]:date:'
  '-e[extract ISO and squashfs contents from iso_name]:ISO file:'
  '-F[force execution without prompting for yes/no]'
  '-g[grml flavour to use]:grml flavour(s):_grmllive_flavours'
  '(-h --help)'{-h,--help}'[display usage information]'
  '-I[directory which provides files that should become part of the chroot/ISO]:directory to include:_path_files -/'
  '-i[iso name, ends up in $OUTPUT_DIRECTORY/grml_isos (also see -o)]:ISO name:_files'
  '-o[output directory]:output directory:_path_files -/'
  '(-b -B -u -q)-q[skip mksquashfs]'
  '-r[release name]:release name:'
  '-R[skip applying the RELEASE class and cleanup]'
  '-s[debian suite to be used for live-system]:Debian suite:_grmllive_suites'
  '(-b -B -u -q)-u[update existing chroot instead of rebuilding it from scratch]'
  '-v[set the grml version number]:version number:'
  '(--bootstrap-mirror-url)-w[wayback machine, build system using Debian archives from specified date]:wayback date(s):_grmllive_apt_snapshot_dates'
)
#}}}

_arguments -s $arguments

